  <XDFFUNCTION uniqueid="0x31EB" flags="0x0">
    <title>1st Piston Ring Emergency Temperature</title>
    <description>Temperate at which the 1st Piston Ring is Critically Overheating and at risk of binding. Increasing this will let the engine run closer to the true point at which the ring may bind at the cost of increased ring binding risk.</description>
    <CATEGORYMEM index="0" category="101" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x1E1E0" mmedelementsizebits="16" mmedcolcount="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
