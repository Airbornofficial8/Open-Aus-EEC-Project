    <mask>0x01</mask>
  </XDFFLAG>
  <XDFFLAG uniqueid="0x781A">
    <title>Allow SSPS test</title>
    <description>Allow testing of the Shift Valves in the BTR. Disable if the car is Manual.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="71" />
    <EMBEDDEDDATA mmedaddress="0x17F69" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x01</mask>
  </XDFFLAG>
  <XDFFLAG uniqueid="0x60F4">
    <title>Allow &quot;mmicont&quot; Test</title>
    <description>Allow the EEC to run the undocumented mmi Test. Not sure what this is, but is normally disabled.</description>
    <CATEGORYMEM index="0" category="6" />
