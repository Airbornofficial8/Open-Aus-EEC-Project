  <XDFFUNCTION uniqueid="0x7034" flags="0x0">
    <title>Cold Lambse Adjustment vs ECT</title>
    <description>Defines a cold multiplier LAMSE for a given engine coolant temperature, used as a kind of warm up enrichment due to the cold fuel table only acting until about 40*c.</description>
    <CATEGORYMEM index="0" category="2" />
    <CATEGORYMEM index="1" category="50" />
    <CATEGORYMEM index="2" category="59" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x15306" mmedelementsizebits="8" mmedcolcount="11" mmedmajorstridebits="-16" mmedminorstridebits="0" />
      <units>ECT *C</units>
      <indexcount>11</indexcount>
      <max>0.000000</max>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="((X*2) - 32) * 5/9">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x15307" mmedelementsizebits="8" mmedcolcount="11" mmedmajorstridebits="-16" mmedminorstridebits="0" />
      <units>LAMSE</units>
      <indexcount>11</indexcount>
      <max>0.000000</max>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/128">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
