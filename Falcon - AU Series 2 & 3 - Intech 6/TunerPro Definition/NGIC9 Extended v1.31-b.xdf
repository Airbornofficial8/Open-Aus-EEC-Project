      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x1E201" mmedelementsizebits="8" mmedcolcount="8" mmedmajorstridebits="-16" mmedminorstridebits="0" />
      <units>Deg</units>
      <indexcount>8</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/2">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
  <XDFFUNCTION uniqueid="0x3885" flags="0x0">
    <title>MBT Retard Limit for Piston Ring Protection vs EGT</title>
    <description>The maximum retard that Piston Ring Protection can request, depending on the calculated exhaust manifold temperature.&#013;&#010;&#013;&#010;This prevents ring protection from pulling ignition timing for too long.</description>
    <CATEGORYMEM index="0" category="101" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x1E210" mmedelementsizebits="8" mmedcolcount="8" mmedmajorstridebits="-16" mmedminorstridebits="0" />
      <units>EGT</units>
      <indexcount>8</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="(X*4)+200">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x1E211" mmedelementsizebits="8" mmedcolcount="8" mmedmajorstridebits="-16" mmedminorstridebits="0" />
      <units>Deg</units>
      <indexcount>8</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/2">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
