  <XDFPATCH uniqueid="0x7CF0">
    <title>Fix DOL Link on Series 1 Hardware</title>
    <description>Due to Memory Map changes in the Series 1 ECU hardware a memory read involved in preparing the DOL message is potentially made corrupt, triggering an invalid DOL message to the cluster.&#013;&#010;&#013;&#010;This patch attempts to fix that issue, potentially fixing the common issue of No Temperature Gauge when Crossflashing to NGIC9 on older N9X.. hardware.</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="81" />
    <CATEGORYMEM index="2" category="17" />
    <XDFPATCHENTRY name="5 - DOL Message Builder grlvr" address="0x2C956" datasize="0x5" patchdata="B301700826" basedata="B3010A1226" />
    <XDFPATCHENTRY name="4 - DOL Message Builder grlvr" address="0x2C8BB" datasize="0x5" patchdata="B301700827" basedata="B3010A1227" />
    <XDFPATCHENTRY name="3 - DOL Message Builder grlvr" address="0x2C844" datasize="0x5" patchdata="B301700827" basedata="B3010A1227" />
    <XDFPATCHENTRY name="2 - DOL Message Builder grlvr" address="0x2C7AD" datasize="0x5" patchdata="C701700842" basedata="C7010A1242" />
    <XDFPATCHENTRY name="1 - DOL Message Builder grlvr" address="0x2C7A9" datasize="0x2" patchdata="2002" basedata="DF02" />
  </XDFPATCH>
  <XDFTABLE uniqueid="0x33E3" flags="0x0">
    <title>Basic Pressure Control - Pressure at 0% Torque</title>
    <description>Defines the pressure when the transmission torque final input is 0% effective engine torque (From engine torque tables). This is used to decide line pressure by forming a slope when the transmission is not in a shift.&#013;&#010;&#013;&#010;Lower values might reduce torque lost to the transmission in gear when not shifting, but might cause slippage. Higher values can reduce slippage in gear (This has no effect on slip during a shift).</description>
    <CATEGORYMEM index="0" category="7" />
    <CATEGORYMEM index="1" category="20" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <indexcount>43</indexcount>
      <outputtype>4</outputtype>
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="1-to-2 Start/Breakout Base" />
      <LABEL index="1" value="1-to-3 Skip Upshift" />
      <LABEL index="2" value="1-to-4 Skip Upshift" />
      <LABEL index="3" value="2-to-1 Downshift" />
      <LABEL index="4" value="2-to-1 Manual Downshift" />
      <LABEL index="5" value="2-to-3 High-Energy Upshift" />
      <LABEL index="6" value="2-to-4 Skip Upshift" />
      <LABEL index="7" value="3-to-1 Skip Downshift" />
      <LABEL index="8" value="3-to-1 Manual Skip Downshift" />
      <LABEL index="9" value="3-to-2 Downshift" />
      <LABEL index="10" value="3-to-2 Manual Downshift" />
      <LABEL index="11" value="3-to-2 High-Speed Downshift" />
      <LABEL index="12" value="3-to-4 High-Energy Upshift" />
      <LABEL index="13" value="4-to-1 Skip Downshift" />
      <LABEL index="14" value="4-to-1 Manual Skip Downshift" />
