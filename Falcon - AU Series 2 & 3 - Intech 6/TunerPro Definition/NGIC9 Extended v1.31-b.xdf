    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x33BE">
    <title>Netural Idle Integral Gain</title>
    <description>This is the Integral Gain of the Closed Loop Idle Control System used when the car is in Netural and the Engine RPM is inside the EECs Idle RPM Range.&#013;&#010;&#013;&#010;Tune this like any other PID system. This value will control the rate at which the EEC responds to RPM error over time.</description>
    <CATEGORYMEM index="0" category="3" />
    <CATEGORYMEM index="1" category="31" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x149A0" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
