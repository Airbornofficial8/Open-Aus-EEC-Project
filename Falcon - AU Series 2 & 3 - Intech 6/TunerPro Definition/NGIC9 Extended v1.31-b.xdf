      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="(X/256*2+40)*5/9-40">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x1E1E2" mmedelementsizebits="16" mmedcolcount="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>*C</units>
      <indexcount>8</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X+40">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
  <XDFFUNCTION uniqueid="0x461A" flags="0x0">
    <title>1st Piston Ring Protection MBT Retard vs Tdelta</title>
    <description>The requested retard from MBT, to protect the 1st Piston Ring from overheating based on the distance from its critical emergency temperature threshold.&#013;&#010;&#013;&#010;This is the mechanism of protection used when the ring is below the critical threshold.</description>
    <CATEGORYMEM index="0" category="101" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x1E200" mmedelementsizebits="8" mmedcolcount="8" mmedmajorstridebits="-16" mmedminorstridebits="0" />
