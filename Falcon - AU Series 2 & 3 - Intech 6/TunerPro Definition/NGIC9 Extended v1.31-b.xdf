    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x3D92">
    <title>TP Voltage Hysterisis for Wide Open Throttle</title>
    <description>The Hysterisis for the WOT mode Threshold. The TP voltage must be higher than TP Threshold for Wide Open Throttle + This value to actually engage WOT mode. To disengage WOT mode, the TP voltage has to drop below the TP Threshold only.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="77" />
