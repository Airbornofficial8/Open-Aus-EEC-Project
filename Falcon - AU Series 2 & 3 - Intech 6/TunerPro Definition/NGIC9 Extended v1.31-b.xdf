  <XDFFUNCTION uniqueid="0x37EB" flags="0x0">
    <title>Spark Only Torque Ratio vs Requester</title>
    <description>Spark Only Torque Ratio vs. Requestor: Spark Only Torque Reductions can only occur above this torque ratio level. If the torque reduction ratio request is above this value then a spark reduction will be used instead of fuel cut torque reduction methods. Set the value for the corresponding torque source to 1.0 to disable spark only cut torque reductions. A value of 0.0 means that up to 100% of torque can be reduced via spark reductions, a value of 0.5 means that up to 50% of torque can be reduced via spark reduction after which cylinders will be disabled (Fuel cut mode).&#013;&#010;&#013;&#010;NGIC and N9XJ Binaries only support Request Mode 9 and 10. Request Mode 2 may also be used for the PWM traction system. Other request modes are not supported.&#013;&#010;&#013;&#010;&#013;&#010;Mode 0 = No or Unofficial Request&#013;&#010;Mode 9 = Failsafe Cooling Control&#013;&#010;Mode 10 = PWM Traction Control</description>
    <CATEGORYMEM index="0" category="10" />
    <CATEGORYMEM index="1" category="92" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x1544E" mmedelementsizebits="8" mmedcolcount="10" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>Torque Source</units>
      <indexcount>10</indexcount>
      <decimalpl>1</decimalpl>
      <max>0.000000</max>
      <outputtype>2</outputtype>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x1544F" mmedelementsizebits="8" mmedcolcount="10" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>Spark Thresh</units>
      <indexcount>10</indexcount>
      <decimalpl>3</decimalpl>
