  <XDFFUNCTION uniqueid="0x3B8C" flags="0x0">
    <title>Cluster Coolant Slope</title>
    <description>Defines the relatonship between the Coolant Temperature and the Command Sent to the Dashboard. The EEC manipulates temperature to prevent gauge fluctuation / to normalise for the behaviour of the CHT sensor into an ECT like value.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="78" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0x126C7" mmedelementsizebits="8" mmedcolcount="10" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>*C</units>
      <indexcount>10</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X * 0.5 + 30">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedaddress="0x126C8" mmedelementsizebits="8" mmedcolcount="10" mmedmajorstridebits="16" mmedminorstridebits="0" />
      <units>Rotation</units>
      <indexcount>10</indexcount>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X * 0.5 + 30">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
