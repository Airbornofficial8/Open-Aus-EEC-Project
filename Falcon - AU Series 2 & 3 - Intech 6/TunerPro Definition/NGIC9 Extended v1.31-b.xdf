  <XDFCONSTANT uniqueid="0x3323">
    <title>Adaptive Learning LAMBSE Error to Learn</title>
    <description>The required amount of Short Term Fuel Correction to make a Long Term Fuel Correction. Set this up so Long Term Fuel Trimming isn&apos;t constantly updating due to excess HEGO swing.</description>
    <CATEGORYMEM index="0" category="2" />
    <CATEGORYMEM index="1" category="53" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x141FA" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
