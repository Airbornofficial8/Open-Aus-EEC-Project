  <XDFFUNCTION uniqueid="0x3A52" flags="0x0">
    <title>CHT Transfer Function</title>
    <description>Transfers Cylinder Head Temperature Voltage to a tangable Temperature Value.&#013;&#010;&#013;&#010;CHT is refered to as ECT in many places. In reality, EEC-V does not actually know the coolant temperature and guesses based on CHT.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="77" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x12532" mmedelementsizebits="16" mmedcolcount="10" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>volts</units>
      <indexcount>10</indexcount>
      <min>1000.000000</min>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/12800">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x12534" mmedelementsizebits="16" mmedcolcount="10" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>deg C</units>
      <indexcount>10</indexcount>
      <min>1000.000000</min>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="(X/256*2+40)*5/9-40">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
  <XDFFUNCTION uniqueid="0x62BE" flags="0x0">
    <title>CHT Volts to Estimated ECT?</title>
    <description>Function being researched. Currently not much use.&#013;&#010;&#013;&#010;Transfers Cylinder Head Temperature Voltage to the estimated 8 bit engine coolant temperature value.&#013;&#010;&#013;&#010;&#013;&#010;This function is what creates the ECT value used across the EEC-V when a measurement of Engine Coolant Temperature is required.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="77" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x12502" mmedelementsizebits="16" mmedcolcount="10" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>volts</units>
      <indexcount>10</indexcount>
      <min>1000.000000</min>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X/12800">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x12504" mmedelementsizebits="16" mmedcolcount="10" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>deg C</units>
      <indexcount>10</indexcount>
      <min>1000.000000</min>
      <embedinfo type="1" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="(5/9)*(X-32)">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFFUNCTION>
  <XDFCONSTANT uniqueid="0xF3E">
    <title>Engine After Shutdown Cooling Factor</title>
    <description>Defines the slope of ECT loss vs time the engine has been turned off for, used until the engine off timer has gone above a limit.&#013;&#010;&#013;&#010;This is used for LPG hot restart predictions.</description>
