    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/4">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x2248">
    <title>NGICX - AirMod Mode</title>
    <description>Defines the mode of operation of the Engine Air Model.&#013;&#010;&#013;&#010;0 = Equipped Pressure Sensor is MAP, Slope Based Aircharge&#013;&#010;1 = No Pressure Sensor Available, MAP is based on TP and RPM and then fed to Slope Based Aircharge&#013;&#010;2 = Equipped Pressure Sensor is TIP, Pressure after the throttle is based on TP and RPM and biased with the Throttle Inlet Pressure from the Pressure Sensor (Boosted AlphaN)&#013;&#010;&#013;&#010;To be added:&#013;&#010;3 = Pressure Sensor Input is a MAF voltage input. MAF is directly received from MAF sensor via slope and MAP is solved from airflow at 32inhg inverse slopes.</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="18" />
    <CATEGORYMEM index="2" category="120" />
    <EMBEDDEDDATA mmedaddress="0x1D180" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>Mode</units>
    <outputtype>2</outputtype>
    <decimalpl>1</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
