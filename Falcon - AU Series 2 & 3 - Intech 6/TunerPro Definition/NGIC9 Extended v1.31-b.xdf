  <XDFPATCH uniqueid="0x4EED">
    <title>Enable EEC Controlled Turbocharger Logic</title>
    <description>(Feature Not Yet Ready)&#013;&#010;&#013;&#010;Enable a custom code patch that gives the EEC control over a boost MAC valve by repurposing the Output used for the Canister Purge.</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="81" />
    <CATEGORYMEM index="2" category="13" />
  </XDFPATCH>
  <XDFFLAG uniqueid="0x62AA">
    <title>Enable EEC Boost Logic</title>
    <description>Enable the EEC to control boost via a MAC valve. You need the above Enable EEC Controlled Turbocharger Logic Patch set before this will work.&#013;&#010;&#013;&#010;When this is disabled, if the above patch is applied, the EEC will always set the MAC duty cycle to the value in the &quot;Wastegate Command Open Duty&quot; scaler.</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="81" />
    <CATEGORYMEM index="2" category="13" />
    <EMBEDDEDDATA mmedaddress="0x18B0F" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x01</mask>
  </XDFFLAG>
  <XDFFLAG uniqueid="0x4885">
    <title>Enable Closed Loop Boost Logic</title>
    <description>Enable the EEC to use closed loop boost control. Set means that when the Boost is within a given Error Range, Closed Loop Boost control will become active, Not set means only open loop boost control can run.</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="81" />
    <CATEGORYMEM index="2" category="13" />
    <EMBEDDEDDATA mmedaddress="0x18B10" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x01</mask>
  </XDFFLAG>
