    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x5C65">
    <title>Underspeed Drive Idle Integral Gain</title>
    <description>This is the Integral Gain of the Closed Loop Idle Control System used when the car is in Drive and the engine is &quot;underspeed&quot;, which in EEC terms means the engnine has fallen below a critical RPM threshold and is about to stall.&#013;&#010;&#013;&#010;Tune this like any other PID system. This value will control the rate at which the EEC responds to RPM error over time.</description>
    <CATEGORYMEM index="0" category="3" />
    <CATEGORYMEM index="1" category="31" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x149A2" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
