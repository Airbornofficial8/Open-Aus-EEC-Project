  <XDFTABLE uniqueid="0x52CF" flags="0x0">
    <title>NGICX - AlphaN Predicted Pressure at Intake Valve</title>
    <description>In AlphaN modes, NGICX predicts the pressure that is currently at the intake valve to give to the Airflow Slope Model. This table defines the pressure that would be present after the throttle body(s) at Standard Baro Pressure in in/hg. With a TIP sensor, the additional pressure created by boost or changing atmospheric condtions is considered / added to this result to create the true absolute pressure at the intake valves / post throttle body(s).</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="18" />
    <CATEGORYMEM index="2" category="123" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>RPM</units>
      <indexcount>16</indexcount>
      <embedinfo type="2" linkobjid="0x56F" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>Volts</units>
      <indexcount>16</indexcount>
      <embedinfo type="2" linkobjid="0x3CFF" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
