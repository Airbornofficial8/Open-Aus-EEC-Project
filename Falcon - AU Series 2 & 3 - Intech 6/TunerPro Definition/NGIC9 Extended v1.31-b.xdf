  <XDFCONSTANT uniqueid="0x6882">
    <title>Fuel Consumption Calculation Interval</title>
    <description>Defines the interval between calculations of lph and conversion with speed into litres per 100km in miliseconds. The stock update rate is every 2 seconds (2000ms)</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="79" />
    <CATEGORYMEM index="2" category="86" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x13528" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
