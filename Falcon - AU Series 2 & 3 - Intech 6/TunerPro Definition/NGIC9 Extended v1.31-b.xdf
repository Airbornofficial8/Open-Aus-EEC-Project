  <XDFCONSTANT uniqueid="0x4276">
    <title>Stoicheometric Air Fuel Ratio</title>
    <description>The Hard Coded Stoich AFR. Its recommended to change the Injector Slope rather than this value, unless you are going for 100% accurate values as this may be unreliable and or a more complex method to use.&#013;&#010;&#013;&#010;NOT COMPATABLE WITH QUARTERHORSE, THIS VARIABLE IS STORED IN THE CODE AREA!&#013;&#010;&#013;&#010;Internally this value is the reciprocal of stoich AFR, but has been mathamaticlly converted to AFR for ease of use.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="79" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x26845" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>AFR</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="32768 / X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
