      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x14924" mmedelementsizebits="8" mmedrowcount="9" mmedcolcount="10" mmedmajorstridebits="0" mmedminorstridebits="0" />
