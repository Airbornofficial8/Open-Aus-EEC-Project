      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x531">
    <title>TP Voltage - Initial RATCH (ECU)</title>
    <description>Initial value for RATCH, which is a variable used to keep track of the lowest throttle voltage recorded since the engine has started. This enables the ECU to always know where Closed Throttle is by keeping track of the lowest voltage it has seen since start.&#013;&#010;&#013;&#010;This is the initial value loaded into said RATCH register, normally set quite high, but then quickly overridden by the initial value measured at the TP sensor.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="77" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x120EA" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>Volts</units>
    <decimalpl>3</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/12800">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x56A3">
    <title>TP Voltage - Initial RATCH (Trans Control)</title>
    <description>Initial value for TRATCH, which is a variable used to keep track of the lowest throttle voltage recorded since the engine has started for the BTR Control logic. This enables the ECU to always know where Closed Throttle is by keeping track of the lowest voltage it has seen since start.&#013;&#010;&#013;&#010;This is used by the BTR for calculating TPPER</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="77" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x15D6A" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>Volts</units>
    <decimalpl>3</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/12800">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x3F02">
    <title>TP Voltage - KAM Learned RATCH Limit (Trans Control)</title>
    <description>After the EEC has learned a RATCH value, when the car is turned off, that value is saved into keep alive memory. This defines the highest value that can be stored into KAM.</description>
