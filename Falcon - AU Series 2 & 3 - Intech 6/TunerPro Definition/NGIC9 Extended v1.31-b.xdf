    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xC61">
    <title>Injector Slope (32lb/min Airflow - Stock)</title>
    <description>This slope is scaled to show correctly for 32lb/min airflow scaling, the stock value. NGICX uses 64lb/min or perhaps you have rescaled to suit even higher?&#013;&#010;&#013;&#010;Injector flow rate in # per hr. Change if you have upgraded injectors. The injectors rated flow at your desired / regulator fuel pressure would go here.&#013;&#010;&#013;&#010;This is one of the most important values in the EEC and handles directly converting airflow / desired fuel flow to the actual injector PW to apply (Before voltage correction, min pw, etc). To change the stoich point for alternate fuels you should use the dedicated Stoich AFR scalar.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="79" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x13570" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>lb/hr</units>
    <decimalpl>3</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/582.5422">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x132E">
    <title>Injector Slope (64lb/min Airflow - NGICX)</title>
    <description>This slope is scaled to show correctly for 64lb/min airflow scaling, the default scaling for NGICX.&#013;&#010;&#013;&#010;Injector flow rate in # per hr. Change if you have upgraded injectors. The injectors rated flow at your desired / regulator fuel pressure would go here.&#013;&#010;&#013;&#010;This is one of the most important values in the EEC and handles directly converting airflow / desired fuel flow to the actual injector PW to apply (Before voltage correction, min pw, etc). To change the stoich point for alternate fuels you should use the dedicated Stoich AFR scalar.</description>
    <CATEGORYMEM index="0" category="6" />
    <CATEGORYMEM index="1" category="79" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0x13570" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
