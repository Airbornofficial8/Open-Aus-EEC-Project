  <XDFCONSTANT uniqueid="0x36E1">
    <title>Ignition Timing Lower Cutoff</title>
    <description>Known as &quot;Spark Lower Clip&quot; in older Strats. This value is still used in N9XJ4 and NGIC9 to Limit Spark Retard to the value here. Final Spark Advance values that fall below this value will be clipped to this value.&#013;&#010;&#013;&#010;Lower this value more to enable spark to retard further than the factory -9.75 Degrees. Up-to -32 Degrees can be reached. Spark can also be clipped off at Positive values too (Up-to +32 Degrees).&#013;&#010;&#013;&#010;WARNING: It is not recommended to set this into positive values. Engine Knock may occur, and this will also prevent the Knock control system from retarding timing below this value.</description>
    <CATEGORYMEM index="0" category="4" />
    <EMBEDDEDDATA mmedtypeflags="0x01" mmedaddress="0x1270A" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>&#176; Spark Timing</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/4">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x5B5C">
    <title>Ignition Timing Upper Cutoff</title>
    <description>Known as &quot;Spark Upper Clip&quot; in older Strats. This value is still used in N9XJ4 and NGIC9 to Limit Spark Advance to the value here. Final Spark Advance values that go above this value will be clipped to this value.&#013;&#010;&#013;&#010;Make sure to also correct your BDLN tables when changing this, as BDLN timing values are only ignored if they are equal to or higher than this value.&#013;&#010;&#013;&#010;Increase this value more to enable spark to advance further than the factory 50&#194;&#176; of advance limit.</description>
    <CATEGORYMEM index="0" category="4" />
    <EMBEDDEDDATA mmedaddress="0x1270B" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>&#176; Spark Timing</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/4">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
