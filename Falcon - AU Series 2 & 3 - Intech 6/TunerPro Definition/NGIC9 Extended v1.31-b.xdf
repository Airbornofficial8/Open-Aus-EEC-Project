  <XDFTABLE uniqueid="0x470B" vislevel="1" flags="0x0">
    <title>Back Pressure - Inferred Delta Pressure</title>
    <description>Table used for estimation of the engine back pressure during PT or WOT by providing the estimated pressure drop across the Throttle Body. &#013;&#010;&#013;&#010;Columms are TPrel (Throttle Voltage - Lowest observed throttle voltage since start)&#013;&#010;Rows are MAP for Estimation of TB Air Pressure Drop&#013;&#010;&#013;&#010;Table was finally cracked after matching it to an American SD bin. It is used during the calculation of Back Pressure for Normalised Fuel Load (MAPOPE) and affects a range of things. Messing with it is generally not recommended unless you are having substantial fueling issues or changing the MAPOPE range / behavour to better support boost or a Throttle Body Change.&#013;&#010;&#013;&#010;Value is fraction of pressure lost over the throttle.</description>
    <CATEGORYMEM index="0" category="1" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <indexcount>5</indexcount>
      <embedinfo type="2" linkobjid="0xE29" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <indexcount>9</indexcount>
      <embedinfo type="2" linkobjid="0x268A" />
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0x123EC" mmedelementsizebits="8" mmedrowcount="9" mmedcolcount="5" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <decimalpl>3</decimalpl>
      <min>0.000000</min>
      <max>255.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="X / 256">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
  <XDFTABLE uniqueid="0x7954" vislevel="2" flags="0x0">
    <title>(B) Back Pressure - Inferred Delta Pressure</title>
    <description>Table used for estimation of the engine back pressure during PT or WOT by providing the estimated pressure drop across the Throttle Body. &#013;&#010;&#013;&#010;Columms are TPrel (Throttle Voltage - Lowest observed throttle voltage since start)&#013;&#010;Rows are MAP for Estimation of TB Air Pressure Drop&#013;&#010;&#013;&#010;Table was finally cracked after matching it to an American SD bin. It is used during the calculation of Back Pressure for Normalised Fuel Load (MAPOPE) and affects a range of things. Messing with it is generally not recommended unless you are having substantial fueling issues or changing the MAPOPE range / behavour to better support boost or a Throttle Body Change.&#013;&#010;&#013;&#010;Value is fraction of pressure lost over the throttle.</description>
