      <EMBEDDEDDATA mmedtypeflags="0x03" mmedaddress="0x14CA4" mmedelementsizebits="16" mmedcolcount="12" mmedmajorstridebits="-32" mmedminorstridebits="0" />
      <units>Advance Offset</units>
