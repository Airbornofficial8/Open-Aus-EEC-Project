  <XDFCONSTANT uniqueid="0x4016">
    <title>NGICX - Minimum RPM to Compute MAP from Airflow</title>
    <description>The minimum RPM at which MAP is computed from airflow, to prevent obscene map,mappa and mapope at very low engine speed.</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="18" />
    <CATEGORYMEM index="2" category="122" />
