      <LABEL index="2" value="1-to-4 Skip Upshift" />
      <LABEL index="3" value="2-to-1 Downshift" />
      <LABEL index="4" value="2-to-1 Manual Downshift" />
      <LABEL index="5" value="2-to-3 High-Energy Upshift" />
      <LABEL index="6" value="2-to-4 Skip Upshift" />
      <LABEL index="7" value="3-to-1 Skip Downshift" />
      <LABEL index="8" value="3-to-1 Manual Skip Downshift" />
      <LABEL index="9" value="3-to-2 Downshift" />
      <LABEL index="10" value="3-to-2 Manual Downshift" />
      <LABEL index="11" value="3-to-2 High-Speed Downshift" />
      <LABEL index="12" value="3-to-4 High-Energy Upshift" />
      <LABEL index="13" value="4-to-1 Skip Downshift" />
      <LABEL index="14" value="4-to-1 Manual Skip Downshift" />
