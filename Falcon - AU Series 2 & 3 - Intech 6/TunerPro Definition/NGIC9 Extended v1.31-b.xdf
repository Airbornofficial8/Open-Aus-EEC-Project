    <decimalpl>3</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/291.2711">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFFLAG uniqueid="0xBB3">
    <title>Fuel Regulator Type</title>
    <description>Defines the type of fuel regulator fitted.&#013;&#010;&#013;&#010;Not Set = Pressure Referenced Linear (Most Modern Regs including the factory one)&#013;&#010;&#013;&#010;Set = Static or Non Linear Pressure Ref (Regs without the Vac Reference connected, or Older Pressure Referenced Regulators)&#013;&#010;&#013;&#010;When the flag is set, the Expected Fuel Regulator Pressure and Delta Pressure Multiplier tables are used to correct for Fuel Pressure being static.</description>
    <CATEGORYMEM index="0" category="6" />
