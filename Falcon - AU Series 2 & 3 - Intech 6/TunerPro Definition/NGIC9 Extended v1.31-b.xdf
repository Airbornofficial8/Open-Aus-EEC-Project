  <XDFCONSTANT uniqueid="0x75EE">
    <title>Wastegate Spring Pressure</title>
    <description>The Spring Pressure of the Mechanical Component of the Wastegate. The EEC won&apos;t command the Wastegate via the Boost Solinoid below this pressure.&#013;&#010;&#013;&#010;Note this pressure is absolute, so add 30in/hg to whatever your gate pressure is in in/hg (E.g. a 6psi gate will be 42in/hg here).</description>
    <CATEGORYMEM index="0" category="5" />
    <CATEGORYMEM index="1" category="81" />
    <CATEGORYMEM index="2" category="13" />
    <EMBEDDEDDATA mmedaddress="0x18A4C" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>in/hg</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/4">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x4242">
