      <LABEL index="32" value="3-to-4 Post-Start Manual Upshift" />
      <LABEL index="33" value="Reserved Shift Class 33" />
      <LABEL index="34" value="Reserved Shift Class 34" />
      <LABEL index="35" value="Reserved 2-to-3 Green/Adaptive" />
      <LABEL index="36" value="Reserved Shift Class 36" />
      <LABEL index="37" value="Reserved Shift Class 37" />
      <LABEL index="38" value="Reserved Shift Class 38" />
      <LABEL index="39" value="Reserved 3-to-4 Green/Adaptive" />
